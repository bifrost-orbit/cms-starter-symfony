# Defaults for every environment. Put your keys in .env.local, which Git leaves out,
# or set them as environment variables on your server.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

CMS_API_URL=https://api.bifrostorbit.com/cms
CMS_PUBLIC_KEY=
CMS_PREVIEW_KEY=
CMS_WEBHOOK_SECRET=
CMS_DEFAULT_REGION=global
